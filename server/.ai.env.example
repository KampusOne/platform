# NEW AI bindings only. Set these on the Cloudflare Worker named platformp.
# The active adapters are Hugging Face and Groq. Never put provider keys in clients.
# HF_TOKEN is a SECRET with Hugging Face Inference Providers permission.
HF_TOKEN=
# Exact currently served model IDs, optionally with an explicit provider suffix.
# Confirm text/image support and your provider allowance before filling these.
HF_CHAT_MODEL=
HF_VISION_MODEL=

# Optional complementary provider. API keys are Worker secrets, never EXPO_PUBLIC vars.
GROQ_API_KEY=
# Official Groq model IDs checked on 2026-09-27. Confirm account model access.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Groq currently lists this image-capable model as preview (evaluate before production).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AI_PRIMARY_PROVIDER=huggingface
# With huggingface selected and fallback false, Groq chat/vision is not used.
# To select Groq directly, set AI_PRIMARY_PROVIDER=groq on the Worker.
# Opt in to forwarding a request to the complementary processor on provider failure.
AI_FALLBACK_ENABLED=false

# Real video cards; enable after supplying a server-only YouTube API key.
AI_VIDEO_SEARCH_ENABLED=false
AI_VIDEO_DAILY_LIMIT=80
YOUTUBE_API_KEY=
