# Kira AI bindings for the Cloudflare Worker named platformp.
# Keep all provider credentials server-side. Never place HF_TOKEN in Expo/public env.
HF_TOKEN=

# Lightweight fallback for normal text, summaries and notes.
HF_CHAT_MODEL=Qwen/Qwen3-4B-Instruct-2507:nscale

# Stronger model used for Ask Kira university-level reasoning. If the hosted
# reasoning route is unavailable, Kira may retry once on HF_CHAT_MODEL.
HF_REASONING_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507:nscale

# Image understanding remains isolated to the configured vision model.
HF_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct:novita

# Speech-to-text model for Kira voice input. Provider routing stays server-side.
HF_TRANSCRIPTION_MODEL=openai/whisper-large-v3
HF_TRANSCRIPTION_FALLBACK_MODEL=openai/whisper-large-v3-turbo

# YouTube learning cards. Keep the API key as a Worker secret, never in mobile/public env.
KIRA_YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=

# Public Kira knowledge that can change without changing prompt code.
KAMPUSONE_PUBLIC_LAUNCH_DATE=2026-10-26
KAMPUSONE_AGENT_APPLICATION_URL=https://agents.kampusone.app/
# Set only when a public waitlist exists.
KAMPUSONE_WAITLIST_URL=
