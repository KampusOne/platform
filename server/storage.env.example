# Storage only. Put these in the Cloudflare Worker, never in Expo or Next public env.
# Keep disabled until credentials, CORS, and a direct upload/playback check pass.
R2_DIRECT_UPLOADS_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET_NAME=kampusone-private
R2_MEDIA_BUCKET_NAME=kampusone-media
R2_UPLOAD_URL_TTL_SECONDS=600
R2_PLAYBACK_URL_TTL_SECONDS=7200

# Bindings are configured in server/wrangler.jsonc, not string ENV values:
# PRIVATE_BUCKET -> kampusone-private
# MEDIA_BUCKET -> kampusone-media
