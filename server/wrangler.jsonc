{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "platformp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": { "crons": ["*/10 * * * *"] },
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "kampusone-media" },
    { "binding": "PRIVATE_BUCKET", "bucket_name": "kampusone-private" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://kampusone-mobile-preview.vercel.app,https://kampusone-platform-preview.vercel.app,https://admin.kampusone.app,https://agents.kampusone.app,https://engineering.kampusone.app",
    "MINIMUM_APP_VERSION": "0.2.0",
    "MAINTENANCE_MODE": "false",
    "ACADEMIC_CORE_ENABLED": "true",
    "SOCIAL_FEED_ENABLED": "true",
    "MARKETPLACE_ENABLED": "false",
    "PHASE_2_SCHEMA_READY": "true",
    "PHASE_3_SCHEMA_READY": "true",
    "UNIFIED_SCHEMA_READY": "true",
    "TUTORIALS_ENABLED": "true",
    "STORE_ENABLED": "true",
    "STORE_DEMO_ENABLED": "false",
    "LOGISTICS_ENABLED": "false",
    "PAYMENTS_ENABLED": "false",
    "AI_ASSISTANT_ENABLED": "true",
    "KIRA_SUBSCRIPTIONS_ENABLED": "false",
    "GA4_ANALYTICS_ENABLED": "true",
    "GA4_MEASUREMENT_ID": "G-GWFL9R95B8",
    "AI_UNLIMITED_EMAIL_HASHES": "af83a966d0eb435808a4657fce605b89077ab7369a7d32caea01ccba0276d3fb",

    "HF_CHAT_MODEL": "Qwen/Qwen3-4B-Instruct-2507:nscale",
    "HF_REASONING_MODEL": "Qwen/Qwen3-235B-A22B-Instruct-2507:nscale",
    "HF_VISION_MODEL": "Qwen/Qwen3-VL-30B-A3B-Instruct:novita",
    "HF_TRANSCRIPTION_MODEL": "openai/whisper-large-v3",
    "HF_TRANSCRIPTION_FALLBACK_MODEL": "openai/whisper-large-v3-turbo",
    "GROQ_TRANSCRIPTION_MODEL": "whisper-large-v3",
    "GEMINI_TRANSCRIPTION_MODEL": "gemini-3.8-flash",
    "KIRA_YOUTUBE_ENABLED": "true",
    "KAMPUSONE_PUBLIC_LAUNCH_DATE": "2026-10-26",
    "KAMPUSONE_AGENT_APPLICATION_URL": "https://agents.kampusone.app/",
    "AI_CHAT_WINDOW_LIMIT": "15",
    "AI_STUDY_TRIAL_LIMIT": "5"
  },
  "env": {
    "staging": {
      "name": "kampusone-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "ALLOWED_ORIGINS": "https://kampusone-platform.vercel.app",
        "MINIMUM_APP_VERSION": "0.2.0",
        "MAINTENANCE_MODE": "false",
        "ACADEMIC_CORE_ENABLED": "true",
        "SOCIAL_FEED_ENABLED": "true",
        "MARKETPLACE_ENABLED": "false",
        "PHASE_2_SCHEMA_READY": "false",
        "PHASE_3_SCHEMA_READY": "false",
        "UNIFIED_SCHEMA_READY": "false",
        "TUTORIALS_ENABLED": "false",
        "STORE_ENABLED": "false",
        "STORE_DEMO_ENABLED": "false",
        "LOGISTICS_ENABLED": "false",
        "PAYMENTS_ENABLED": "false",
        "AI_ASSISTANT_ENABLED": "false",
        "KIRA_SUBSCRIPTIONS_ENABLED": "false",
        "GA4_ANALYTICS_ENABLED": "false",
        "GA4_MEASUREMENT_ID": ""
      }
    }
  }
}
