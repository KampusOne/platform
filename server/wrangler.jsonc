{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kampusone-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:8081",
    "MINIMUM_APP_VERSION": "0.1.0",
    "MAINTENANCE_MODE": "false",
    "IDENTITY_ENABLED": "true",
    "ACADEMIC_CORE_ENABLED": "true",
    "NOTIFICATIONS_ENABLED": "false",
    "AGENT_APPLICATIONS_ENABLED": "true",
    "SOCIAL_FEED_ENABLED": "false",
    "MESSAGING_ENABLED": "false",
    "EVENTS_ENABLED": "false",
    "LEARNING_MARKETPLACE_ENABLED": "false",
    "MARKETPLACE_ENABLED": "false",
    "RIDER_DISPATCH_ENABLED": "false",
    "PAYMENTS_ENABLED": "false",
    "AI_ASSISTANT_ENABLED": "false"
  },
  "env": {
    "preview": {
      "name": "kampusone-api-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "ALLOWED_ORIGINS": "https://kampusone-platform.vercel.app,https://kampusone-ops.vercel.app,https://kampusone-agents.vercel.app,https://kampusone-build.vercel.app",
        "MINIMUM_APP_VERSION": "0.1.0",
        "MAINTENANCE_MODE": "false",
        "IDENTITY_ENABLED": "true",
        "ACADEMIC_CORE_ENABLED": "true",
        "NOTIFICATIONS_ENABLED": "false",
        "AGENT_APPLICATIONS_ENABLED": "true",
        "SOCIAL_FEED_ENABLED": "false",
        "MESSAGING_ENABLED": "false",
        "EVENTS_ENABLED": "false",
        "LEARNING_MARKETPLACE_ENABLED": "false",
        "MARKETPLACE_ENABLED": "false",
        "RIDER_DISPATCH_ENABLED": "false",
        "PAYMENTS_ENABLED": "false",
        "AI_ASSISTANT_ENABLED": "false"
      }
    },
    "production": {
      "name": "kampusone-api",
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://app.kampusone.app,https://ops.kampusone.app,https://agents.kampusone.app,https://build.kampusone.app",
        "MINIMUM_APP_VERSION": "0.1.0",
        "MAINTENANCE_MODE": "true",
        "IDENTITY_ENABLED": "false",
        "ACADEMIC_CORE_ENABLED": "false",
        "NOTIFICATIONS_ENABLED": "false",
        "AGENT_APPLICATIONS_ENABLED": "false",
        "SOCIAL_FEED_ENABLED": "false",
        "MESSAGING_ENABLED": "false",
        "EVENTS_ENABLED": "false",
        "LEARNING_MARKETPLACE_ENABLED": "false",
        "MARKETPLACE_ENABLED": "false",
        "RIDER_DISPATCH_ENABLED": "false",
        "PAYMENTS_ENABLED": "false",
        "AI_ASSISTANT_ENABLED": "false"
      },
      "routes": [
        {
          "pattern": "api.kampusone.app",
          "custom_domain": true
        }
      ]
    }
  }
}
