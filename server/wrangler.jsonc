{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "platformp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "kampusone-media" },
    { "binding": "PRIVATE_BUCKET", "bucket_name": "kampusone-private" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://kampusone-mobile-preview.vercel.app,https://kampusone-platform-preview.vercel.app,https://admin.kampusone.app,https://agents.kampusone.app,https://engineering.kampusone.app",
    "MINIMUM_APP_VERSION": "0.2.0",
    "MAINTENANCE_MODE": "false",
    "ACADEMIC_CORE_ENABLED": "true",
    "SOCIAL_FEED_ENABLED": "true",
    "MARKETPLACE_ENABLED": "false",
    "PHASE_2_SCHEMA_READY": "true",
    "PHASE_3_SCHEMA_READY": "true",
    "UNIFIED_SCHEMA_READY": "true",
    "TUTORIALS_ENABLED": "true",
    "STORE_ENABLED": "false",
    "STORE_DEMO_ENABLED": "false",
    "LOGISTICS_ENABLED": "false",
    "PAYMENTS_ENABLED": "false",
    "AI_ASSISTANT_ENABLED": "true",
    "AI_UNLIMITED_EMAIL_HASHES": "af83a966d0eb435808a4657fce605b89077ab7369a7d32caea01ccba0276d3fb",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "HF_CHAT_MODEL": "Qwen/Qwen3-4B-Instruct-2507:nscale"
  },
  "env": {
    "staging": {
      "name": "kampusone-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "ALLOWED_ORIGINS": "https://kampusone-platform.vercel.app",
        "MINIMUM_APP_VERSION": "0.2.0",
        "MAINTENANCE_MODE": "false",
        "ACADEMIC_CORE_ENABLED": "true",
        "SOCIAL_FEED_ENABLED": "false",
        "MARKETPLACE_ENABLED": "false",
        "PHASE_2_SCHEMA_READY": "false",
        "PHASE_3_SCHEMA_READY": "false",
        "UNIFIED_SCHEMA_READY": "false",
        "TUTORIALS_ENABLED": "false",
        "STORE_ENABLED": "false",
        "STORE_DEMO_ENABLED": "false",
        "LOGISTICS_ENABLED": "false",
        "PAYMENTS_ENABLED": "false",
        "AI_ASSISTANT_ENABLED": "false"
      }
    }
  }
}
