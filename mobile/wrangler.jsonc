{
  "$schema": "../server/node_modules/wrangler/config-schema.json",
  "name": "kampusone-app-local",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "preview": {
      "name": "kampusone-app-preview",
      "assets": {
        "directory": "./dist/",
        "not_found_handling": "single-page-application"
      }
    },
    "production": {
      "name": "kampusone-app",
      "assets": {
        "directory": "./dist/",
        "not_found_handling": "single-page-application"
      },
      "routes": [
        {
          "pattern": "app.kampusone.app",
          "custom_domain": true
        }
      ]
    }
  }
}
