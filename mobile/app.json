{
  "expo": {
    "name": "KampusOne",
    "slug": "kampusone",
    "version": "0.3.22",
    "orientation": "portrait",
    "icon": "./assets/kampusone-app-icon.jpg",
    "scheme": "kampusone",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FBF7F2",
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kampusone.mobile",
      "associatedDomains": [
        "applinks:links.kampusone.app"
      ],
      "buildNumber": "52"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/kampusone-app-icon.jpg",
        "backgroundColor": "#F1DFC7"
      },
      "package": "app.kampusone.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "links.kampusone.app",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 52
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/kampusone-app-icon.jpg"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "android": false,
            "ios": false
          }
        }
      ],
      "@react-native-firebase/app",
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "withoutAdIdSupport": true
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow KampusOne to record a message for Kira.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": true
        }
      ],
      "./plugins/with-kampus-alarms",
      "./plugins/with-branded-video-trim",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow KampusOne to use your location while you navigate around campus."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://mobile.kampusone.app/api",
      "apiFallbackUrl": "https://platformp.divine-haze-54eb.workers.dev"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
